# Where each node runs in distributed mode (MODE=distributed ./network.sh ...).
# Use fixed addresses (DHCP reservation in the router) and prefer Ethernet over Wi-Fi.
#
# Topology:
#   pi3 : peer0.org1 (emergency)
#   pi5 : peer0.org2 (hospital), orderer1
#   mac : peer0.org3 (audit), orderer2, orderer3, Caliper, gateway
#
# A node whose address equals MAC_HOST runs locally (no SSH), so setting every
# address to MAC_HOST runs the whole distributed layout on this machine for testing.

MAC_HOST=192.168.15.7
PI3_HOST=192.168.15.6
PI5_HOST=192.168.15.10

PI3_USER=victor
PI5_USER=victor

# Directory on the Raspberry Pis that receives the compose file and crypto material
REMOTE_DIR=telehealth-fabric
