          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "diagnosis",
            "update",
            "{{diagnosisId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"new_status\": \"UNDER_REVIEW\",\n  \"diagnosis\": \"AMI confirmed - ECG with ST elevation\",\n  \"observation\": \"Patient referred to hemodynamics. Thrombolytic administered.\",\n  \"severity\": \"orange\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
